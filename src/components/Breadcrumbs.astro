---
interface Props { current: string; }
import { t } from '../i18n/messages';
const { current } = Astro.props;
---
<nav class="breadcrumbs" aria-label={t('breadcrumbs')} data-i18n-aria-label="breadcrumbs">
  <ol><li><a href="/" data-i18n="home">{t('home')}</a></li><li aria-current="page">{current}</li></ol>
</nav>
